{
  "name": "Complaint analysis",
  "dataColors": ["#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#6250d6", "#e34948"],
  "background": "#FFFFFF",
  "foreground": "#0B0B0B",
  "tableAccent": "#2A78D6",
  "textClasses": {
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 26, "color": "#0B0B0B" },
    "title":   { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#0B0B0B" },
    "header":  { "fontFace": "Segoe UI Semibold", "fontSize": 10, "color": "#0B0B0B" },
    "label":   { "fontFace": "Segoe UI", "fontSize": 10, "color": "#52514E" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "border": [{ "show": false }],
        "dropShadow": [{ "show": false }],
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F5F5F4" } }, "transparency": 0 }]
      }
    }
  }
}
